{
  "name": "chatgpt",
  "displayName": "ChatGPT",
  "description": "Run ChatGPT models in Copilot Chat, Claude Code, and Codex with browser login and multi-account rotation.",
  "version": "1.0.0",
  "publisher": "kerklangsi",
  "author": {
    "name": "kerklangsi",
    "url": "https://github.com/kerklangsi"
  },
  "license": "MIT",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#0D1117",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "chatgpt",
    "openai",
    "gpt-4o",
    "o1",
    "o3-mini",
    "copilot",
    "claude code",
    "codex",
    "browser login",
    "account manager",
    "quota"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguageModelChatProvider:chatgpt"
  ],
  "main": "./dist/extension.js",
  "type": "commonjs",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "chatgpt",
        "displayName": "ChatGPT"
      }
    ],
    "commands": [
      {
        "command": "chatgpt.openAccounts",
        "title": "ChatGPT: Open Accounts Panel",
        "icon": "$(account)"
      },
      {
        "command": "chatgpt.addAccount",
        "title": "ChatGPT: Add ChatGPT Account",
        "icon": "$(add)"
      },
      {
        "command": "chatgpt.refreshQuotas",
        "title": "ChatGPT: Refresh Quotas",
        "icon": "$(sync)"
      },
      {
        "command": "chatgpt.switchAccount",
        "title": "ChatGPT: Switch Active Account",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "chatgpt.removeAccount",
        "title": "ChatGPT: Remove Account",
        "icon": "$(trash)"
      },
      {
        "command": "chatgpt.claudeCode.apply",
        "title": "ChatGPT: Use Model in Claude Code",
        "icon": "$(rocket)"
      },
      {
        "command": "chatgpt.claudeCode.restore",
        "title": "ChatGPT: Restore Claude Code Defaults (Anthropic)",
        "icon": "$(discard)"
      },
      {
        "command": "chatgpt.codex.apply",
        "title": "ChatGPT: Use Model in Codex",
        "icon": "$(rocket)"
      },
      {
        "command": "chatgpt.codex.restore",
        "title": "ChatGPT: Restore Codex Defaults (OpenAI)",
        "icon": "$(discard)"
      },
      {
        "command": "chatgpt.copilot.setup",
        "title": "ChatGPT: Set Up Copilot Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "chatgpt.copilot.restore",
        "title": "ChatGPT: Restore Copilot Chat Defaults",
        "icon": "$(discard)"
      },
      {
        "command": "chatgpt.commitMessages.apply",
        "title": "ChatGPT: Use Model for Commit Messages",
        "icon": "$(git-commit)"
      },
      {
        "command": "chatgpt.commitMessages.restore",
        "title": "ChatGPT: Restore Commit Messages to Copilot",
        "icon": "$(discard)"
      },
      {
        "command": "chatgpt.restartGateway",
        "title": "ChatGPT: Restart Local Gateway",
        "icon": "$(debug-restart)"
      },
      {
        "command": "chatgpt.copyGatewayInfo",
        "title": "ChatGPT: Copy Local Gateway URL and Key",
        "icon": "$(clippy)"
      },
      {
        "command": "chatgpt.showLogs",
        "title": "ChatGPT: Show Logs",
        "icon": "$(output)"
      },
      {
        "command": "chatgpt.showStatus",
        "title": "ChatGPT: Show Integration Status",
        "icon": "$(info)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "chatgpt",
          "title": "ChatGPT",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "views": {
      "chatgpt": [
        {
          "id": "chatgpt-accounts",
          "name": "ChatGPT",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "ChatGPT",
      "properties": {
        "chatgpt.gateway.port": {
          "type": "number",
          "default": 8766,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Preferred port for the local gateway that Claude Code and Codex talk to."
        },
        "chatgpt.gateway.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start the local gateway automatically when VS Code launches."
        },
        "chatgpt.quota.autoRefreshMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 240,
          "description": "How often to refresh ChatGPT account session and status in the background."
        },
        "chatgpt.rotation.strategy": {
          "type": "string",
          "enum": [
            "highest-quota-first",
            "round-robin",
            "manual"
          ],
          "default": "highest-quota-first",
          "description": "How to rotate between multiple connected ChatGPT accounts when limits are reached."
        },
        "chatgpt.rotation.cooldownMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 1440,
          "description": "Fallback cooldown applied to an account after a rate limit."
        },
        "chatgpt.rotation.maxWaitSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "maximum": 300,
          "description": "How long a request may wait for a cooling-down account to recover before failing."
        },
        "chatgpt.saveHistoryInChatGPTWeb": {
          "type": "boolean",
          "default": false,
          "description": "Whether to save API conversations into your ChatGPT web chat history sidebar."
        },
        "chatgpt.claudeCode.settingsScope": {
          "type": "string",
          "enum": [
            "user",
            "project"
          ],
          "default": "user",
          "description": "Where to write Claude Code environment settings."
        },
        "chatgpt.claudeCode.smallFastModel": {
          "type": "string",
          "default": "",
          "description": "Model ID used for Claude Code background tasks."
        },
        "chatgpt.codex.configPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Codex config.toml."
        },
        "chatgpt.reloadOnModelChange": {
          "type": "string",
          "enum": [
            "prompt",
            "auto",
            "never"
          ],
          "default": "prompt",
          "description": "Prompt to reload VS Code after changing models for Claude Code or Codex."
        },
        "chatgpt.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "Minimum log level for the ChatGPT output channel."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "compile": "tsc --noEmit",
    "watch": "node esbuild.js --watch",
    "test": "tsc -p tsconfig.json && node --test \"out/__tests__/*.test.js\"",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.104.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0"
  }
}
